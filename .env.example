# ===== Sao chép thành .env.local (local) hoặc khai báo trong Vercel > Settings > Environment Variables =====

# Tên site hiển thị (tiêu đề, header, email...). Bỏ trống thì dùng mặc định "Gieo Quẻ Kinh Dịch".
NEXT_PUBLIC_SITE_NAME=Gieo Quẻ Kinh Dịch
# URL chính thức của site (dùng cho sitemap/robots), ví dụ https://ten-mien-cua-ban.vn — không có dấu / cuối.
NEXT_PUBLIC_SITE_URL=

# ===== Supabase (supabase.com > Project Settings > API) =====
# URL của project, dạng https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon public key — dùng cho đăng nhập admin ở trình duyệt
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — TUYỆT MẬT, chỉ dùng phía server trong API routes, không bao giờ đưa ra trình duyệt
SUPABASE_SERVICE_ROLE_KEY=
# Danh sách email được vào trang /admin, cách nhau bằng dấu phẩy
ADMIN_EMAILS=you@example.com

# ===== Tài khoản nhận chuyển khoản VietQR =====
# Mã ngân hàng theo chuẩn VietQR (ví dụ: MB, VCB, TCB, ACB, BIDV...) hoặc mã số BIN
BANK_ID=
# Số tài khoản nhận tiền
BANK_ACCOUNT=
# Tên chủ tài khoản (hiển thị cho khách đối chiếu)
BANK_HOLDER=
